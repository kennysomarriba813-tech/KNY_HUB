local function GetCharParts()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
    end
    return nil, nil
end

local function ApplyStats()
    local hum = GetCharParts()
    if not hum then return end
    hum.WalkSpeed = State.WalkSpeed
    if hum.UseJumpPower then
        hum.JumpPower = State.JumpPower
    else
        hum.JumpHeight = math.max(1, math.floor(State.JumpPower * 0.14))
    end
end

local function CheckSafe(name)
    if not State.SafeEnabled then
        Notify("Seguro Activado", "Activa 'Habilitar Controles' primero para usar " .. name .. ".", 4, C.Gold, "SEGURIDAD")
        return false
    end
    return true
end

