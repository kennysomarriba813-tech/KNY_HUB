task.spawn(function()
    TweenService:Create(LineTop, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
        Position = UDim2.new(0.1, 0, 0.20, 0),
        Size = UDim2.new(0.8, 0, 0, 2)
    }):Play()

    TweenService:Create(LineBot, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
        Position = UDim2.new(0.1, 0, 0.80, 0),
        Size = UDim2.new(0.8, 0, 0, 2)
    }):Play()

    TweenService:Create(SplashTitle, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0
    }):Play()
    task.wait(0.25)
    TweenService:Create(SplashSub, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0
    }):Play()

    local stages = {
        { target = 0.20, dur = 3.0, msg = "Verificando perfil de " .. LocalPlayer.Name .. "..." },
        { target = 0.45, dur = 3.0, msg = "Analizando experiencia: " .. GameName .. "..." },
        { target = 0.70, dur = 3.0, msg = "Cargando módulos visuales y notificaciones..." },
        { target = 0.90, dur = 3.0, msg = "Optimizando interfaz para " .. DeviceLabel .. "..." },
        { target = 1.00, dur = 2.0, msg = "KNY_HUB listo para iniciar." }
    }

    local totalTime = 15
    local startT = tick()

    for _, st in ipairs(stages) do
        SplashStep.Text = st.msg
        local stepT = tick()
        local fromPct = BarFill.Size.X.Scale

        while (tick() - stepT) < st.dur do
            local alpha = math.clamp((tick() - stepT) / st.dur, 0, 1)
            local nowPct = fromPct + (st.target - fromPct) * alpha
            BarFill.Size = UDim2.new(nowPct, 0, 1, 0)

            local left = math.max(0, math.ceil(totalTime - (tick() - startT)))
            SplashPct.Text = string.format("%d%%  •  %ds restantes", math.floor(nowPct * 100), left)
            task.wait(0.05)
        end

        BarFill.Size = UDim2.new(st.target, 0, 1, 0)
    end

    SplashPct.Text = "100%  •  Completado"
    PlaySfx(SFX.Success, 0.45, 1)
    task.wait(0.35)

    for _, d in ipairs(Splash:GetDescendants()) do
        if d:IsA("TextLabel") then
            TweenService:Create(d, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
        elseif d:IsA("Frame") then
            TweenService:Create(d, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
        end
    end

    local fadeSplash = TweenService:Create(Splash, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    })
    fadeSplash:Play()
    fadeSplash.Completed:Wait()
    Splash:Destroy()

    local savedKey = ReadKey()
    local savedOk, savedRole, cleanSaved = CheckKey(savedKey)
    if savedOk then
        OpenMainHub(cleanSaved, savedRole)
    else
        KeyScreen.Visible = true
        TweenService:Create(KeyPanel, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(0.5, 0.5)
        }):Play()
        Notify("Acceso Requerido", "Ingresa tu key de KNY_HUB para entrar.", 4, C.Blue, "KEY")
    end
end)
