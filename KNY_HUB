-- 11. VALIDACIÓN DE KEY (LIMPIA Y SIN PISTAS)
-- ==========================================
local function NormalizeKey(raw)
    if type(raw) ~= "string" then return "" end
    -- Elimina espacios, saltos de línea, tabulaciones y convierte a mayúsculas
    local cleaned = raw:gsub("[%s%c]", ""):upper()
    return cleaned
end

local function CheckKey(raw)
    local clean = NormalizeKey(raw)
    if clean == "" then return false, nil, "" end
    local role = KeyConfig.ValidKeys[clean]
    if role then
        return true, role, clean
    end
    return false, nil, clean
end

local function SaveKey(k)
    pcall(function()
        if typeof(writefile) == "function" then
            writefile(KeyConfig.SaveFileName, k)
        end
    end)
end

local function ReadKey()
    local out = nil
    pcall(function()
        if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(KeyConfig.SaveFileName) then
            out = readfile(KeyConfig.SaveFileName)
        end
    end)
    return out
end

local function DelKey()
    pcall(function()
        if typeof(isfile) == "function" and typeof(delfile) == "function" and isfile(KeyConfig.SaveFileName) then
            delfile(KeyConfig.SaveFileName)
        end
    end)
end

